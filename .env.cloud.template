# AetherTalk Cloud Configuration Template
# Copy this file to .env.cloud and fill in your actual credentials

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/database
NEON_DATABASE_URL=postgresql://username:password@host:5432/database
NEON_PROJECT_ID=your-project-id
NEON_API_KEY=your-neon-api-key

# Redis Configuration (Redis Cloud)
REDIS_URL=redis://username:password@host:port
REDIS_CLOUD_URL=redis://username:password@host:port
REDIS_CLOUD_API_KEY=your-redis-api-key

# MEGA Storage Configuration
MEGA_EMAIL=your-mega-email@example.com
MEGA_PASSWORD=your-mega-password
MEGA_STORAGE_ENABLED=true

# Google Drive Configuration (Optional)
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token
GOOGLE_DRIVE_ENABLED=false

# Microsoft OneDrive Configuration (Optional)
ONEDRIVE_CLIENT_ID=your-onedrive-client-id
ONEDRIVE_CLIENT_SECRET=your-onedrive-client-secret
ONEDRIVE_REFRESH_TOKEN=your-refresh-token
ONEDRIVE_ENABLED=false

# Firebase Configuration (Phone Authentication)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
FIREBASE_ADMIN_SDK_PATH=config/firebase-admin-sdk.json
FIREBASE_WEB_API_KEY=your-web-api-key

# Push Notifications
FCM_PROJECT_ID=your-firebase-project-id

# Phone Verification Settings
PHONE_VERIFICATION_ENABLED=true
PHONE_VERIFICATION_TIMEOUT=300
PHONE_VERIFICATION_MAX_ATTEMPTS=3
PHONE_VERIFICATION_RESEND_DELAY=60

# Translation Services
LECTO_AI_API_KEY=your-lecto-ai-api-key
MAESTRA_API_KEY=your-maestra-api-key
NOTEGPT_API_KEY=your-notegpt-api-key

# Streaming Translation Settings
STREAMING_TRANSLATION_ENABLED=true
STREAMING_TRANSLATION_BUFFER_SIZE=1024
STREAMING_TRANSLATION_TIMEOUT=30

# Application Settings
APP_ENV=production
LOG_LEVEL=info
PORT=8080
HOST=0.0.0.0

# Security Settings
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-encryption-key
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60