[
    {aethertalk, [
        {http_port, 8080},
        {https_port, 8443},
        {websocket_port, 8081},
        {max_connections, 10000},
        {database_pool_size, 20},
        {redis_pool_size, 10},
        {media_storage_path, "./media"},
        {encryption_key, <<"aethertalk_encryption_key_change_in_production">>},
        {jwt_secret, <<"aethertalk_jwt_secret_change_in_production">>},
        {translation_api_key, undefined},
        {aws_access_key, undefined},
        {aws_secret_key, undefined},
        {aws_region, "us-east-1"},
        {stun_servers, [
            "stun:stun.l.google.com:19302",
            "stun:stun1.l.google.com:19302",
            "stun:stun2.l.google.com:19302"
        ]},
        {turn_servers, []},
        {max_file_size, 104857600}, % 100MB
        {supported_languages, [
            "en", "es", "fr", "de", "it", "pt", "ru", "zh", "ja", "ko", "ar", "hi"
        ]},
        % Cloud Database Configuration - Neon PostgreSQL
        {database, [
            {host, {env, "AETHERTALK_DB_HOST", "localhost"}},
            {port, {env, "AETHERTALK_DB_PORT", 5432}},
            {database, {env, "AETHERTALK_DB_NAME", "aethertalk"}},
            {username, {env, "AETHERTALK_DB_USER", "aethertalk"}},
            {password, {env, "AETHERTALK_DB_PASS", "aethertalk_password"}},
            {pool_size, 20},
            {max_overflow, 10},
            {ssl, {env, "AETHERTALK_DB_SSL", true}},
            {ssl_opts, [
                {verify, verify_peer},
                {cacerts, public_key:cacerts_get()},
                {server_name_indication, disable}
            ]}
        ]},
        % Cloud Redis Configuration
        {redis, [
            {host, {env, "AETHERTALK_REDIS_HOST", "localhost"}},
            {port, {env, "AETHERTALK_REDIS_PORT", 6379}},
            {database, 0},
            {pool_size, 10},
            {password, {env, "AETHERTALK_REDIS_PASSWORD", undefined}},
            {ssl, {env, "AETHERTALK_REDIS_SSL", false}},
            {ssl_opts, [
                {verify, verify_peer},
                {cacerts, public_key:cacerts_get()}
            ]}
        ]},
        % Cloud Media Storage Configuration
        {media_storage, [
            {type, {env, "MEDIA_STORAGE_TYPE", "mega"}}, % mega, google_drive, onedrive
            {mega, [
                {username, {env, "MEGA_USERNAME", undefined}},
                {password, {env, "MEGA_PASSWORD", undefined}}
            ]},
            {google_drive, [
                {client_id, {env, "GOOGLE_DRIVE_CLIENT_ID", undefined}},
                {client_secret, {env, "GOOGLE_DRIVE_CLIENT_SECRET", undefined}},
                {refresh_token, {env, "GOOGLE_DRIVE_REFRESH_TOKEN", undefined}}
            ]},
            {onedrive, [
                {client_id, {env, "ONEDRIVE_CLIENT_ID", undefined}},
                {client_secret, {env, "ONEDRIVE_CLIENT_SECRET", undefined}},
                {refresh_token, {env, "ONEDRIVE_REFRESH_TOKEN", undefined}}
            ]}
        ]},
        {media_processing, [
            {image_max_width, 1920},
            {image_max_height, 1080},
            {video_max_duration, 300}, % 5 minutes
            {audio_max_duration, 600}, % 10 minutes
            {thumbnail_size, 150}
        ]},
        {call_settings, [
            {max_participants, 50},
            {recording_enabled, true},
            {quality_levels, [low, medium, high, hd]},
            {default_quality, medium}
        ]},
        {security, [
            {rate_limit_per_minute, 100},
            {max_login_attempts, 5},
            {session_timeout, 86400}, % 24 hours
            {password_min_length, 8},
            {require_2fa, false}
        ]},
        % Cloud Translation Service
        {translation, [
            {provider, {env, "TRANSLATION_PROVIDER", "google"}}, % google, azure, aws, libre
            {google, [
                {api_key, {env, "GOOGLE_TRANSLATE_API_KEY", undefined}},
                {project_id, {env, "GOOGLE_TRANSLATE_PROJECT_ID", undefined}}
            ]},
            {azure, [
                {api_key, {env, "AZURE_TRANSLATOR_API_KEY", undefined}},
                {region, {env, "AZURE_TRANSLATOR_REGION", undefined}},
                {endpoint, {env, "AZURE_TRANSLATOR_ENDPOINT", "https://api.cognitive.microsofttranslator.com"}}
            ]},
            {aws, [
                {access_key, {env, "AWS_TRANSLATE_ACCESS_KEY", undefined}},
                {secret_key, {env, "AWS_TRANSLATE_SECRET_KEY", undefined}},
                {region, {env, "AWS_TRANSLATE_REGION", "us-east-1"}}
            ]},
            {libre, [
                {url, {env, "LIBRETRANSLATE_URL", "http://localhost:5000"}},
                {api_key, {env, "LIBRETRANSLATE_API_KEY", undefined}}
            ]}
        ]},
        % Cloud Monitoring and Logging
        {monitoring, [
            {enabled, true},
            {metrics_port, 9100},
            {health_check_enabled, true},
            {sentry_dsn, {env, "SENTRY_DSN", undefined}}
        ]}
    ]},
    {lager, [
        {log_root, "./logs"},
        {handlers, [
            {lager_console_backend, [
                {level, info},
                {formatter, lager_default_formatter},
                {formatter_config, [date, " ", time, " [", severity, "] ", pid, " ", message, "\n"]}
            ]},
            {lager_file_backend, [
                {file, "error.log"},
                {level, error},
                {size, 10485760},
                {date, "$D0"},
                {count, 5}
            ]},
            {lager_file_backend, [
                {file, "console.log"},
                {level, info},
                {size, 10485760},
                {date, "$D0"},
                {count, 5}
            ]}
        ]}
    ]},
    {ssl, [
        {session_lifetime, 600},
        {session_cache_client_max, 1000},
        {session_cache_server_max, 1000}
    ]},
    {mnesia, [
        {dir, "./data/mnesia"}
    ]},
    {sasl, [
        {sasl_error_logger, {file, "./logs/sasl-error.log"}},
        {errlog_type, error},
        {error_logger_mf_dir, "./logs/sasl"},
        {error_logger_mf_maxbytes, 10485760},
        {error_logger_mf_maxfiles, 5}
    ]}
].