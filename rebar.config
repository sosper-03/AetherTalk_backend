{erl_opts, [debug_info, warnings_as_errors, warn_export_all, warn_unused_import]}.

{deps, [
    {cowboy, "2.12.0"},           % HTTP/WebSocket server
    {jsx, "3.1.0"},               % JSON encoding/decoding
    {poolboy, "1.5.2"},           % Connection pooling
    {epgsql, "4.7.1"},            % PostgreSQL driver
    {eredis, "1.7.1"},            % Redis client
    {uuid, "2.0.7", {pkg, uuid_erl}}, % UUID generation
    {bcrypt, "1.2.2"},            % Password hashing
    {jose, "1.11.10"},            % JWT/JWE/JWS/JWK support
    {gun, "2.1.0"},               % HTTP/2 and WebSocket client
    {hackney, "1.20.1"},          % HTTP client
    {lager, "3.9.2"},             % Logging framework
    {recon, "2.5.6"},             % Production debugging tools
    {observer_cli, "1.7.4"},      % Observer CLI for monitoring
    {ranch, "2.1.0"},             % Socket acceptor pool
    {ssl_verify_fun, "1.1.7"},    % SSL verification functions
    {jiffy, "1.1.2"},             % Fast JSON encoder/decoder
    {gen_smtp, "1.2.0"},          % SMTP client
    {erlcloud, "3.7.2"},          % AWS SDK
    {emqtt, "1.11.0"}             % MQTT client
]}.

{relx, [
    {release, {aethertalk, "1.0.0"}, [
        aethertalk,
        sasl,
        runtime_tools,
        observer,
        wx,
        tools
    ]},
    {mode, dev},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.

{profiles, [
    {prod, [
        {erl_opts, [no_debug_info, warnings_as_errors]},
        {relx, [{mode, prod}]}
    ]},
    {test, [
        {deps, [
            {proper, "1.4.0"},
            {meck, "0.9.2"}
        ]}
    ]}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [aethertalk]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        race_conditions,
        unknown
    ]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [mnesia, crypto, ssl, public_key]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
