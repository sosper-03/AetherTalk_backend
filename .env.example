# AetherTalk Backend Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=production

# Application name and version
APP_NAME=AetherTalk
APP_VERSION=1.0.0

# Server configuration
PORT=8080
SSL_PORT=8443
HOST=0.0.0.0

# Erlang/OTP configuration
ERLANG_COOKIE=change_me_to_secure_random_string
NODE_NAME=aethertalk@localhost

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aethertalk
DB_USER=aethertalk
DB_PASSWORD=change_me_to_secure_password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_SSL=false

# Database connection string (alternative to individual settings)
# DATABASE_URL=postgresql://aethertalk:password@localhost:5432/aethertalk

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Cache and Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_to_secure_redis_password
REDIS_DB=0
REDIS_POOL_SIZE=10

# Redis connection string (alternative)
# REDIS_URL=redis://:password@localhost:6379/0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_SECRET=change_me_to_very_secure_jwt_secret_key_minimum_32_characters
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# Encryption keys
ENCRYPTION_KEY=change_me_to_32_character_encryption_key
ENCRYPTION_ALGORITHM=aes-256-gcm

# Session configuration
SESSION_SECRET=change_me_to_secure_session_secret
SESSION_TIMEOUT=3600

# CORS settings
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=20

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# File upload settings
UPLOAD_MAX_SIZE=104857600
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,video/mp4,audio/mpeg,application/pdf
UPLOAD_PATH=/opt/aethertalk/uploads

# File storage (local, s3, gcs, azure)
STORAGE_TYPE=local
STORAGE_PATH=/opt/aethertalk/uploads

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=aethertalk-uploads

# Google Cloud Storage (if using GCS)
GCS_PROJECT_ID=your_project_id
GCS_BUCKET=aethertalk-uploads
GCS_KEY_FILE=/path/to/service-account.json

# Azure Blob Storage (if using Azure)
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key
AZURE_CONTAINER=aethertalk-uploads

# =============================================================================
# TRANSLATION SERVICES
# =============================================================================

# Google Translate API
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
GOOGLE_TRANSLATE_PROJECT_ID=your_google_project_id

# Azure Translator
AZURE_TRANSLATOR_API_KEY=your_azure_translator_key
AZURE_TRANSLATOR_REGION=your_azure_region
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# AWS Translate
AWS_TRANSLATE_ACCESS_KEY=your_aws_access_key
AWS_TRANSLATE_SECRET_KEY=your_aws_secret_key
AWS_TRANSLATE_REGION=us-east-1

# LibreTranslate (self-hosted)
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=your_libretranslate_api_key

# Default translation provider (google, azure, aws, libre)
DEFAULT_TRANSLATION_PROVIDER=libre

# =============================================================================
# WEBRTC CONFIGURATION
# =============================================================================

# STUN servers
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN server configuration
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your_turn_username
TURN_PASSWORD=your_turn_password
TURN_REALM=your_domain.com

# WebRTC settings
WEBRTC_MAX_BITRATE=2000000
WEBRTC_MIN_BITRATE=100000
WEBRTC_PREFERRED_CODEC=VP8

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Email templates
EMAIL_FROM=noreply@aethertalk.com
EMAIL_FROM_NAME=AetherTalk

# =============================================================================
# PUSH NOTIFICATIONS
# =============================================================================

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key
FCM_PROJECT_ID=your_firebase_project_id

# Apple Push Notifications
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_BUNDLE_ID=com.aethertalk.app
APNS_PRIVATE_KEY_PATH=/path/to/apns-key.p8
APNS_PRODUCTION=false

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Logging configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/opt/aethertalk/logs/aethertalk.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10

# Metrics and monitoring
METRICS_ENABLED=true
METRICS_PORT=9100
METRICS_PATH=/metrics

# Health check configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/api/health

# Sentry error tracking
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=production

# =============================================================================
# CLUSTERING AND SCALING
# =============================================================================

# Cluster configuration
CLUSTER_ENABLED=true
CLUSTER_NAME=aethertalk-cluster
CLUSTER_DISCOVERY_TYPE=dns
CLUSTER_DISCOVERY_SERVICE=aethertalk-backend

# Load balancing
LOAD_BALANCER_ALGORITHM=round_robin
STICKY_SESSIONS=true

# Auto-scaling
AUTO_SCALING_ENABLED=false
AUTO_SCALING_MIN_INSTANCES=2
AUTO_SCALING_MAX_INSTANCES=10
AUTO_SCALING_CPU_THRESHOLD=70

# =============================================================================
# MULTI-TENANT CONFIGURATION
# =============================================================================

# Multi-tenancy settings
MULTI_TENANT_ENABLED=true
DEFAULT_TENANT_ID=default
TENANT_ISOLATION_LEVEL=database

# Tenant limits
DEFAULT_USER_LIMIT=1000
DEFAULT_STORAGE_LIMIT=10737418240
DEFAULT_BANDWIDTH_LIMIT=1073741824

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Webhook configuration
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_TIMEOUT=30000

# Third-party integrations
SLACK_BOT_TOKEN=your_slack_bot_token
DISCORD_BOT_TOKEN=your_discord_bot_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Debug settings (only for development)
DEBUG=false
DEBUG_SQL=false
DEBUG_WEBSOCKET=false

# Hot reloading (development only)
HOT_RELOAD=false

# Test database (for running tests)
TEST_DB_NAME=aethertalk_test
TEST_DB_USER=aethertalk_test
TEST_DB_PASSWORD=test_password

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_TYPE=local
BACKUP_PATH=/opt/aethertalk/backups

# S3 backup configuration
BACKUP_S3_BUCKET=aethertalk-backups
BACKUP_S3_REGION=us-east-1

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL certificate paths
SSL_CERT_PATH=/etc/ssl/certs/aethertalk.crt
SSL_KEY_PATH=/etc/ssl/private/aethertalk.key
SSL_CA_PATH=/etc/ssl/certs/ca-bundle.crt

# SSL settings
SSL_PROTOCOLS=TLSv1.2,TLSv1.3
SSL_CIPHERS=ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512
SSL_VERIFY_CLIENT=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Connection pool settings
HTTP_POOL_SIZE=100
HTTP_POOL_TIMEOUT=30000

# Cache settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Worker process settings
WORKER_PROCESSES=auto
WORKER_CONNECTIONS=1024

# Memory limits
MAX_MEMORY_USAGE=2048MB
GC_THRESHOLD=80